<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F111A"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔥 Free Fire AI Control"
        android:textColor="#FF4757"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <!-- خانة إدخال مفتاح الذكاء الاصطناعي -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="مفتاح الذكاء الاصطناعي (API Key):"
        android:textColor="#A4B0BE"
        android:textSize="14sp"
        android:layout_marginBottom="4dp"/>

    <EditText
        android:id="@+id/etApiKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="textPassword"
        android:background="#1A1C29"
        android:textColor="#FFFFFF"
        android:padding="12dp"
        android:layout_marginBottom="12dp"/>

    <!-- خانة كتابة المهمة أو الأمر -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="اكتب المهمة (مثال: Battle Royale، مدة 20 دقيقة):"
        android:textColor="#A4B0BE"
        android:textSize="14sp"
        android:layout_marginBottom="4dp"/>

    <EditText
        android:id="@+id/etTask"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:gravity="top"
        android:inputType="textMultiLine"
        android:background="#1A1C29"
        android:textColor="#FFFFFF"
        android:padding="12dp"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btnExecute"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="إرسال وبدء التنفيذ الفوري"
        android:backgroundTint="#FF4757"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"/>

    <!-- شاشة السجلات والمراقبة الحية (Console) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="سجل المراقبة الحية وتخطيط الذكاء الاصطناعي:"
        android:textColor="#A4B0BE"
        android:textSize="14sp"
        android:layout_marginBottom="4dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000"
        android:padding="8dp">
        <TextView
            android:id="@+id/tvConsole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="> النظام جاهز في انتظار إدخال المفتاح والمهمة...\n"
            android:textColor="#2ED573"
            android:fontFamily="monospace"
            android:textSize="12sp"/>
    </ScrollView>

</LinearLayout>
